{
  "$schema": "https://tauri.stable.app/v1",
  "identifier": "ai.omnicoder",
  "productName": "omnicoder",
  "version": "0.1.0",
  "bundle": {
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  },
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OmniCoder",
        "width": 1280,
        "height": 860,
        "minWidth": 940,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}